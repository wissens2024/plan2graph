# ── 대용량 데이터 (서버 단일 보관, git 제외) ──
/data/raw/               # 원본 다운로드 전부: aihub·cubicasa5k·rplan·_archives
/data/v2v/               # V2V YOLO 데이터셋·예측(이미지 다수) — 재생성
/data/processed_val/
/건축 도면 데이터/         # (구) 로컬 AI-Hub raw — data/raw/aihub로 이관, 삭제 예정
/data/processed/graphs/
/data/releases/*/graphs/
/data/interim/law_cache/
/data/interim/*.xml
/data/interim/*.json
/data/interim/inventory.csv
/data/interim/fp_label_coverage.csv
/data/interim/scale.csv

# ── 모델 체크포인트 ──
/models/
*.pt
*.pth
*.onnx
*.owl

# ── 시각화 산출 ──
/notebooks/*.png
/notebooks/gate/*.png
/ontology/*.png

# ── 추적: 코드·문서·규칙DB·릴리스 메타(manifest/eval/splits/card)·요약 CSV ──
#   (legal/*.json, *.md, data/releases/*/{manifest,eval,splits,dataset_card}, *.csv 요약은 추적)

# ── 실험 원장(runs/): 프로비넌스·비교표는 추적, 체크포인트(*.pt)는 위 규칙으로 제외 ──
#   runs/<run_id>/{meta.json,metrics.json,train.log} + runs/index.jsonl = git 추적(재현·비교)
#   runs/<run_id>/checkpoint.pt = *.pt 규칙으로 제외(시드+코드로 재생성)

# 런타임 로그(서버 nohup 산출 — 추적 제외)
/logs/
# YOLO(ultralytics) 학습 산출물 — 재생성(*.pt는 위 규칙으로 제외)
/runs/segment/

# Python / 환경 / OS
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.env
.streamlit/
